# Build the LaTeX decks. Two passes: the second resolves \inserttotalframenumber.
#
# Requires only texlive-latex-recommended + pgf (beamer, tikz, pgfplots,
# listings, booktabs). No contributed themes, no tcolorbox, no fontawesome --
# the decks must build on a bare TeX Live and in CI.

LATEX   ?= pdflatex
LFLAGS   = -interaction=nonstopmode -halt-on-error -file-line-error
PY      ?= python3
TEX      = $(wildcard *.tex)
PDF      = $(TEX:.tex=.pdf)

.PHONY: all figures kit-figures clean distclean
all: $(PDF)

# Figures are generated by running the real pipeline, so the decks cannot drift
# from the code. ~60 s: it simulates a commissioning window, a 90-day
# run-to-failure series and a 7-seed grouped fleet evaluation.
figures:
	$(PY) figures/make_core_figures.py --out figures

# Per-kit figures come from the shared energy model, so they cannot disagree
# with tools/power_budget.py and a corrected datasheet figure propagates.
KITS = $(notdir $(wildcard ../hardware/*))
kit-figures:
	@for k in $(KITS); do \
	    key=$$(echo $$k | tr '-' '_'); \
	    $(PY) figures/make_kit_figures.py --kit $$key --out figures || true; \
	done
# A few kits have a figure that is specific to what makes them different, and
# that no shared generator can produce -- the RA8D1's order-tracking
# measurement runs the kit's own C test and plots its output.
	@for g in $(wildcard figures/make_*_figures.py); do \
	    case $$g in *make_core_figures.py|*make_kit_figures.py) ;; \
	        *) $(PY) $$g --out figures || true ;; \
	    esac; \
	done

%.pdf: %.tex common/pdmtheme.sty
	$(LATEX) $(LFLAGS) $< >/dev/null || { $(LATEX) -interaction=nonstopmode $< | tail -40; false; }
	$(LATEX) $(LFLAGS) $< >/dev/null
	@echo "built $@"

clean:
	rm -f *.aux *.log *.nav *.out *.snm *.toc *.vrb *.synctex.gz

distclean: clean
	rm -f $(PDF) figures/*.png
